{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "LLM": {
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "Model": "gpt-4o-mini"
  },
  "Auth": {
    "JwtSecret": "supersecretkey_change_me_to_something_very_long_at_least_32_characters",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 7,
    "AdminPassword": "changeme"
  },
  "Chat": {
    "StrictEditorUpdateEnforcement": true,
    "MaxToolExecutionRounds": 8
  },
  "BackgroundTasks": {
    "Workers": [
      {
        "Name": "worker-transcription",
        "AllowedTaskTypes": [ "source-transcription" ]
      },
      {
        "Name": "worker-general-1",
        "AllowedTaskTypes": [ "feed-ingestion", "source-scrape", "draft-chat-summary", "workflow-draft-retry", "scheduled-publishing", "workflow-reply-check-post", "reply-thread-summary" ]
      },
      {
        "Name": "worker-general-2",
        "AllowedTaskTypes": [ "feed-ingestion", "source-scrape", "draft-chat-summary", "workflow-draft-retry", "scheduled-publishing", "workflow-reply-check-post", "reply-thread-summary" ]
      },
      {
        "Name": "worker-general-3",
        "AllowedTaskTypes": [ "feed-ingestion", "source-scrape", "draft-chat-summary", "workflow-draft-retry", "scheduled-publishing", "workflow-reply-check-post", "reply-thread-summary" ]
      }
    ]
  },
  "Transcriber": {
    "BaseUrl": "http://localhost:8102",
    "TimeoutSeconds": 1800,
    "TranscriptsPath": "/app/transcripts"
  },
  "ImageEngine": {
    "BaseUrl": "http://localhost:8103",
    "TimeoutSeconds": 30
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=socialworker;Username=postgres;Password=postgres"
  }
}