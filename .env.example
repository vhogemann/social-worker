SW_API_IMAGE=ghcr.io/vhogemann/social-worker-api:latest
SW_WEB_IMAGE=ghcr.io/vhogemann/social-worker-web:latest

LLM__BaseUrl=https://openrouter.ai/api/v1
LLM__ApiKey=or-...
LLM__Model=anthropic/claude-3.5-sonnet
# Set only for deterministic e2e runs. Leave empty for normal local usage.
DEMO_LLM_PROFILE=

Search__Provider=SearXng
Search__BraveApiKey=

ConnectionStrings__Default=Host=localhost;Database=socialworker;Username=postgres;Password=postgres

Postgres__Password=postgres

# Auth Configuration
Auth__JwtSecret=secret_key_must_be_at_least_32_characters_long_for_security_reasons
Auth__AdminPassword=changeme
Auth__AccessTokenLifetimeMinutes=60
Auth__RefreshTokenLifetimeDays=7
Auth__DbEncryptionKey=6Hu0Ff4LtNcJDESsBHL40zKqhfOoAVKURp+8jAwZQLw=

# Transcriber / Whisper service
WHISPER_CACHE_DIR=./whisper-cache
TRANSCRIBER__WhisperModel=base
TRANSCRIBER__SummaryEngine=disabled
TRANSCRIBER__SummaryUrl=
TRANSCRIBER__SummaryModel=
TRANSCRIBER__SummaryApiKey=
TRANSCRIBER__SummaryMaxChars=12000
TRANSCRIBER__TimeoutSeconds=1800

# LinkedIn OAuth Configuration (Personal Profile: Share on LinkedIn + Sign In with OpenID)
LINKEDIN__CLIENTID=
LINKEDIN__CLIENTSECRET=
LINKEDIN__REDIRECTURI=https://social.plopsaurus.xyz/oauth/callback/linkedin
# LINKEDIN__SCOPES=w_member_social openid profile

# LinkedIn OAuth Configuration (Company Pages: Community Management API app)
LINKEDIN__COMPANY__CLIENTID=
LINKEDIN__COMPANY__CLIENTSECRET=
LINKEDIN__COMPANY__REDIRECTURI=https://social.plopsaurus.xyz/oauth/callback/linkedin
# LINKEDIN__COMPANY__SCOPES=w_organization_social r_organization_admin

# Meta Threads OAuth Configuration
METATHREADS__APPID=
METATHREADS__APPSECRET=
METATHREADS__REDIRECTURI=https://social.plopsaurus.xyz/oauth/callback/threads
# Required for media/image attachments so Meta can download the media:
METATHREADS__PUBLICBASEURL=https://social.plopsaurus.xyz

# Twitter / X OAuth 2.0 PKCE Configuration
TWITTER__CLIENTID=
TWITTER__CLIENTSECRET=
TWITTER__REDIRECTURI=https://social.plopsaurus.xyz/oauth/callback/twitter

# Meta / Instagram Graph API Configuration (Business Discovery & Content Ingestion)
INSTAGRAM__APPID=
INSTAGRAM__APPSECRET=
INSTAGRAM__REDIRECTURI=https://social.plopsaurus.xyz/oauth/callback/instagram
# Optional direct token and caller Instagram Business/Creator Account ID:
INSTAGRAM__ACCESSTOKEN=
INSTAGRAM__CALLERUSERID=


