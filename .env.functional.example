# Social Worker Functional Test Configuration
# Copy this file to .env.functional and fill in your credentials.

# Social Worker instance URL and user credentials
FUNCTIONAL_SW_URL=http://localhost:8101
FUNCTIONAL_SW_USERNAME=admin
FUNCTIONAL_SW_PASSWORD=changeme

# Dedicated Bluesky test account credentials (App Password generated in Bluesky Settings)
FUNCTIONAL_BLUESKY_HANDLE=your-test-account.bsky.social
FUNCTIONAL_BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
FUNCTIONAL_BLUESKY_PDS_URL=https://bsky.social

# Test behavior options
# Set to 'true' to automatically delete test posts from Bluesky after ATProto verification
FUNCTIONAL_CLEANUP_POSTS=true

# Tag prefix for test drafts created in Social Worker
FUNCTIONAL_TAG=[functional-test]
